# ==============================================================================
# Docker build context exclusions
# Build context is repo root (.), Dockerfile at backend/Dockerfile
# ==============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# --- Virtual environments ---
.venv/
venv/
backend/.venv/
backend/venv/

# --- Environment / secrets ---
.env
backend/.env

# --- Frontend (not needed for backend image) ---
frontend/

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo

# --- Git ---
.git/
.gitignore

# --- Planning docs ---
.planning/

# --- Data files ---
*.xlsx
backend/uploads/

# --- OS ---
.DS_Store
Thumbs.db

# --- Dev tooling ---
.dev-pids/
madebykav-app-template/

# --- Docker ---
docker-compose*.yml
